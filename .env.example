# Telegram
BOT_TOKEN=put_your_bot_token_here
CHANNEL_ID=@your_channel_username
ADMIN_ID=123456789
TELEGRAM_PROXY_URL=

# Optional AI editor. If absent, VOID uses fallback templates.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-5.4
OPENAI_POST_MODEL=openai/gpt-5.4-mini
OPENAI_DIALOG_MODEL=openai/gpt-5.4
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium

# Cross-posting
NAZ_CHANNEL_ID=@naz_ai_channel_username
NAZ_BOT_TOKEN=
CROSSPOST_DAILY_LIMIT=2
CROSSPOST_EXCHANGE_ENABLED=true
CROSSPOST_EXCHANGE_AUTO_PUBLISH=true
CROSSPOST_EXCHANGE_DIR=/opt/bot_exchange
CROSSPOST_EXCHANGE_INTERVAL_SECONDS=300
CROSSPOST_EXCHANGE_MAX_PER_RUN=1

# VK publisher
VK_USER_ACCESS_TOKEN=
VK_GROUP_ID=237593988
VK_API_VERSION=5.199
VK_DRY_RUN=true

# Optional
DB_PATH=void.db
SCAN_LIMIT_PER_SOURCE=8
MAX_SCAN_RESULTS=12
