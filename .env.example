# Telegram
BOT_TOKEN=put_your_bot_token_here
CHANNEL_ID=@your_channel_username
ADMIN_ID=123456789
TELEGRAM_PROXY_URL=

# Optional AI editor. If absent, VOID uses fallback templates.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-5.4
OPENAI_POST_MODEL=openai/gpt-5.4-mini
OPENAI_DIALOG_MODEL=openai/gpt-5.4
OPENAI_IMAGE_MODEL=openai/gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium

# Manual ADMIN_ID-only laboratory. Keep disabled in normal/scheduled runtime.
VOID_V14_ENABLED=false

# Voice messages: official OpenAI API, intentionally separate from OpenRouter
VOICE_MESSAGES_ENABLED=false
VOICE_MESSAGES_ADMIN_ONLY=true
OPENAI_VOICE_API_KEY=sk-your_official_openai_key_here
OPENAI_VOICE_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
# Shared Realtime Voice Hub (server-side key; model is intentionally fixed)
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
VOICE_HUB_ALLOWED_TELEGRAM_USER_IDS=123456789
VOICE_HUB_MAX_SESSION_SECONDS=900
VOICE_HUB_TELEGRAM_AUTH_MAX_AGE_SECONDS=300
VOICE_HUB_EPHEMERAL_TTL_SECONDS=60
VOICE_HUB_STATE_DB=data/voice_hub.sqlite3
VOICE_HUB_NAZ_ADAPTER_SOCKET=/run/naz-realtime/adapter.sock
VOICE_HUB_HOST=127.0.0.1
VOICE_HUB_PORT=8080
VOICE_MAX_BYTES=15728640
VOICE_MAX_DURATION_SECONDS=300

# Cross-posting
CROSSPOST_DAILY_LIMIT=2
CROSSPOST_EXCHANGE_ENABLED=true
CROSSPOST_EXCHANGE_AUTO_PUBLISH=true
CROSSPOST_EXCHANGE_DIR=/opt/bot_exchange
CROSSPOST_EXCHANGE_INTERVAL_SECONDS=300
CROSSPOST_EXCHANGE_MAX_PER_RUN=1

# VOID Telegram autoposting (Europe/Moscow)
VOID_TELEGRAM_AUTO_TIMES=12:00,16:00,20:00,00:00

# VK publisher
VK_USER_ACCESS_TOKEN=
VK_PHOTO_ACCESS_TOKEN=
VK_GROUP_ID=237593988
VK_API_VERSION=5.199
VK_DRY_RUN=true
VK_MUSIC_TRACKS_FILE=data/vk_music_tracks.json
VK_COMMUNITY_URL=https://vk.com/club237593988
VK_BROWSER_PROFILE_DIR=/var/lib/void-vk-publisher/profile
VK_BROWSER_PAYLOAD_DIR=data/vk_browser_payloads
VK_BROWSER_HEADLESS=false
VK_BROWSER_STORAGE_STATE=
VK_PUBLISH_QUEUE_DIR=/var/lib/void-vk-publisher/queue
VK_TRACK_ROTATION_SIZE=149
VK_MAX_PUBLISH_RETRIES=12
VK_PUBLISH_MIN_INTERVAL_SECONDS=3600
VK_PUBLISH_KILL_SWITCH=/etc/void-vk-publisher.disabled
VOID_VK_PRODUCER_ON=true
VK_VPS_DB_SCP=user@your-vps:/opt/void_entity/void.db

# VOID private-message bot for the VK community. This is a separate process
# and requires a dedicated community token; never reuse VK_USER_ACCESS_TOKEN.
VK_COMMUNITY_BOT_ENABLED=false
VK_COMMUNITY_BOT_GROUP_ID=237593988
VK_COMMUNITY_ALLOWED_GROUP_IDS=237593988
VK_GROUP_ACCESS_TOKEN=
VK_COMMUNITY_ALLOWED_USER_IDS=
VK_COMMUNITY_WELCOME_ENABLED=false
VK_COMMUNITY_WELCOME_TEXT=
VK_COMMUNITY_PUBLIC_REPLIES_ENABLED=false
VK_COMMUNITY_STATE_DB=/var/lib/void-vk-community/events.sqlite3
VK_COMMUNITY_HEALTH_FILE=/var/lib/void-vk-community/status.json
VOID_VK_DIALOG_DB_PATH=/var/lib/void-vk-community/dialog.sqlite3
VOID_CHARACTER_DB_PATH=/opt/void_entity/void.db

# Optional
DB_PATH=void.db
SCAN_LIMIT_PER_SOURCE=8
MAX_SCAN_RESULTS=12
