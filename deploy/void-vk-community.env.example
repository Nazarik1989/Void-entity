# Copy to /etc/void-vk-community.env with owner root:void and mode 0640.
# Keep this file disabled until community messages and Bots Long Poll are enabled.
VK_COMMUNITY_BOT_ENABLED=false
VK_COMMUNITY_BOT_GROUP_ID=237593988
VK_COMMUNITY_ALLOWED_GROUP_IDS=237593988

# Dedicated community access token. Never use VK_USER_ACCESS_TOKEN here.
VK_GROUP_ACCESS_TOKEN=
VK_API_VERSION=5.199

# Empty means every VK user may start a private conversation. To run a closed
# pilot, use a comma-separated list of positive VK user IDs.
VK_COMMUNITY_ALLOWED_USER_IDS=

VK_COMMUNITY_STATE_DB=/var/lib/void-vk-community/events.sqlite3
VK_COMMUNITY_HEALTH_FILE=/var/lib/void-vk-community/status.json
VOID_VK_DIALOG_DB_PATH=/var/lib/void-vk-community/dialog.sqlite3

# Read only. The adapter copies no Telegram messages and reads only VOID's
# canonical character_states row from this database.
VOID_CHARACTER_DB_PATH=/opt/void_entity/void.db

VK_COMMUNITY_LONG_POLL_WAIT_SECONDS=25
VK_COMMUNITY_HTTP_TIMEOUT_SECONDS=40
VK_COMMUNITY_USER_RATE_LIMIT=6
VK_COMMUNITY_USER_RATE_WINDOW_SECONDS=60
VK_COMMUNITY_MAX_TEXT_CHARS=4000
VK_COMMUNITY_MAX_REPLY_CHARS=3500
VK_COMMUNITY_MAX_ATTEMPTS=5
VK_COMMUNITY_RETRY_BASE_SECONDS=5
VK_COMMUNITY_PROCESSING_LEASE_SECONDS=300

# Dialogue generation. Keep secrets only in this root-owned environment file.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=openai/gpt-5.4
OPENAI_DIALOG_MODEL=openai/gpt-5.4
VOID_DIALOG_MAX_OUTPUT_TOKENS=500
